# Copy this file to `.env` and fill in the real values from your Supabase project.

# Postgres connection string used by Prisma (both for queries and migrations).
# Use Supabase's SESSION pooler (port 5432) or the direct connection — never
# the transaction pooler (port 6543), which breaks Prisma's session-scoped
# connection usage. Find it in Supabase: Project Settings -> Database.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase project URL and public anon key (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key (Project Settings -> API). Server-side only —
# used to upload/read images in the private storage bucket. Never expose
# this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"


# ---------- Optional ----------

# Connections each process opens to the database (default 3). Supabase's
# session pooler allows few for the whole project; raise only on a paid plan.
DATABASE_POOL_MAX=

# Map style (default: OpenFreeMap "liberty", free and keyless). Point it at a
# paid provider's style URL (MapTiler, Stadia…) when traffic grows.
NEXT_PUBLIC_MAP_STYLE_URL=

# Address search uses Nominatim (OpenStreetMap) unless this key is set; its
# policy only allows light use. Geoapify's free tier allows commercial use.
GEOAPIFY_API_KEY=
# Contact (email or URL) Nominatim asks apps to send with each request.
NOMINATIM_CONTACT=
