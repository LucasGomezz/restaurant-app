// use prisma-next

types {
  /// Supabase Auth user id (auth.users.id).
  AuthUserId = Uuid
  /// Random id for rows reached by link, so they can't be guessed.
  RandomId   = Uuid
}

enum RestaurantStatus {
  @@type("pg/text@1")
  pending = "PENDING"
  visited = "VISITED"
}

/// What a member may do in a folder (see lib/access.ts).
enum FolderRole {
  @@type("pg/text@1")
  owner  = "OWNER"
  editor = "EDITOR"
  viewer = "VIEWER"
}

enum FriendshipStatus {
  @@type("pg/text@1")
  pending  = "PENDING"
  accepted = "ACCEPTED"
}

enum PlaceKind {
  @@type("pg/text@1")
  restaurant = "RESTAURANT"
  trip       = "TRIP"
  event      = "EVENT"
}

// Historical name: holds every place (restaurants, trips and events).
model Restaurant {
  id        Int              @id @default(autoincrement())
  /// Who created the place. Null only for rows from before accounts existed,
  /// until scripts/claim-data.ts assigns them: nobody sees an ownerless place.
  ownerId   AuthUserId?
  owner     Profile?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  lat       Float
  lng       Float
  status    RestaurantStatus
  kind      PlaceKind         @default(restaurant)
  /// Optional custom type (e.g. "Bodega"); `kind` keeps its base behaviour.
  categoryId Int?
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Events only: when it takes place (known before going).
  eventDate TimestamptzString?
  notes     String?
  createdAt TimestamptzString @default(now())
  visits    Visit[]
  folders   FolderPlace[]

  @@index([ownerId])
  @@index([status])
  @@index([kind])
  @@index([categoryId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// Custom place types created from the app (e.g. "Bodega" 🍷). Each one behaves
// like a built-in kind: dishes for restaurants, return date for trips...
model Category {
  id        Int               @id @default(autoincrement())
  /// Each user has their own types. Null only for rows from before accounts.
  ownerId   AuthUserId?
  owner     Profile?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  icon      String
  baseKind  PlaceKind
  createdAt TimestamptzString @default(now())

  @@unique([ownerId, name])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

model Visit {
  id             Int               @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visitDate      TimestamptzString
  /// Trips only: return date (visitDate is the departure).
  endDate        TimestamptzString?
  description    String
  coupleImageUrl String?
  /// width / height of coupleImageUrl, so layouts can size frames before loading.
  coupleImageRatio Float?
  placeImageUrl  String?
  /// width / height of placeImageUrl.
  placeImageRatio  Float?
  createdAt      TimestamptzString @default(now())
  dishes         Dish[]
  photos         Photo[]

  @@index([restaurantId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

model Dish {
  id          Int     @id @default(autoincrement())
  visitId     Int
  visit       Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?

  @@index([visitId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// Carousel photos of a visit.
model Photo {
  id        Int               @id @default(autoincrement())
  visitId   Int
  visit     Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  path      String
  position  Int               @default(0)
  createdAt TimestamptzString @default(now())

  @@index([visitId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// Public identity of a Supabase Auth user. Created on first sign-in
// (/bienvenida); the app requires one before letting the user in.
model Profile {
  id          AuthUserId        @id
  /// Unique handle used to find friends, e.g. "lucas.gomez".
  username    String            @unique
  displayName String
  createdAt   TimestamptzString @default(now())
  places      Restaurant[]
  categories  Category[]
  memberships FolderMember[]
  friendsLow  Friendship[]      @relation("FriendshipLow")
  friendsHigh Friendship[]      @relation("FriendshipHigh")

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// A shared folder ("Con Juan", "Mendoza 2026"): its members see every place
// added to it. With dates it is a trip folder. Roles live in FolderMember.
model Folder {
  id          RandomId          @id @default(uuid())
  name        String
  description String?
  icon        String            @default("📁")
  /// Trip folders: first and last day.
  startDate   TimestamptzString?
  endDate     TimestamptzString?
  createdAt   TimestamptzString @default(now())
  members     FolderMember[]
  places      FolderPlace[]
  invites     FolderInvite[]

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

model FolderMember {
  id       Int               @id @default(autoincrement())
  folderId RandomId
  folder   Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId   AuthUserId
  user     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     FolderRole
  joinedAt TimestamptzString @default(now())

  @@unique([folderId, userId])
  @@index([userId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// A place added to a folder. Only the place's owner can add it (lib/access.ts).
model FolderPlace {
  id       Int               @id @default(autoincrement())
  folderId RandomId
  folder   Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  placeId  Int
  place    Restaurant        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  addedAt  TimestamptzString @default(now())

  @@unique([folderId, placeId])
  @@index([placeId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// A join link for a folder: /invitacion/<id>. Reusable until it expires or
// the owner replaces it.
model FolderInvite {
  id        RandomId          @id @default(uuid())
  folderId  RandomId
  folder    Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// Role given to whoever joins through the link (never OWNER).
  role      FolderRole
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([folderId])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// Two users who are friends (or one asked the other). Stored once per pair,
// ordered (userLow < userHigh), so the pair can't appear twice. Being friends
// gives no access to anything: it only makes inviting to folders easier.
model Friendship {
  id          Int               @id @default(autoincrement())
  userLow     AuthUserId
  low         Profile           @relation("FriendshipLow", fields: [userLow], references: [id], onDelete: Cascade)
  userHigh    AuthUserId
  high        Profile           @relation("FriendshipHigh", fields: [userHigh], references: [id], onDelete: Cascade)
  status      FriendshipStatus
  /// Who sent the request (one of the two).
  requestedBy AuthUserId
  createdAt   TimestamptzString @default(now())

  @@unique([userLow, userHigh])
  @@index([userHigh])

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}

// Address searches already answered, so the same query doesn't hit the
// geocoding provider again (lib/geocoding.ts). Not user data.
model GeocodeCache {
  /// "<provider>:<normalized query>".
  key       String            @id
  /// JSON array of { displayName, lat, lng }.
  results   String
  createdAt TimestamptzString @default(now())

  // RLS on with no policies: the public API (anon key) gets nothing;
  // the app connects as the table owner, which bypasses RLS.
  @@rls
}
